### The full builder implementation

```cpp
#include "minishield/StateMachineBuilder.h"
#include "llvm/ADT/DenseMap.h"
#include "llvm/IR/IRBuilder.h"
#include "llvm/IR/Instructions.h"
#include "llvm/Support/ErrorHandling.h"
#include <vector>

namespace minishield {
bool StateMachineBuilder::build(llvm::Function &F) {
    auto &entry = F.getEntryBlock();
    if (F.size() < 2 || entry.getTerminator()->getNumSuccessors() == 0)
        return false;

    std::vector<llvm::BasicBlock *> states;
    std::vector<llvm::Instruction *> terminators;
    llvm::DenseMap<llvm::BasicBlock *, unsigned> ids;
    for (auto &BB : F) {
        terminators.push_back(BB.getTerminator());
        if (&BB != &entry) {
            ids[&BB] = static_cast<unsigned>(states.size());
            states.push_back(&BB);
        }
    }
    llvm::IRBuilder<> setup(&*entry.getFirstInsertionPt());
    auto *slot = setup.CreateAlloca(setup.getInt32Ty(), nullptr, "ms.state");
    auto *dispatch = llvm::BasicBlock::Create(F.getContext(), "ms.dispatch", &F);
    auto *invalid = llvm::BasicBlock::Create(F.getContext(), "ms.invalid", &F);
    llvm::IRBuilder<> invalidBuilder(invalid);
    invalidBuilder.CreateUnreachable();
    llvm::IRBuilder<> db(dispatch);
    auto *current = db.CreateLoad(db.getInt32Ty(), slot, "ms.current");
    auto *stateSwitch = db.CreateSwitch(current, invalid,
                                      static_cast<unsigned>(states.size()));
    auto stateOf = [&](llvm::BasicBlock *BB) -> llvm::ConstantInt * {
        auto it = ids.find(BB);
        if (it == ids.end())
            llvm::report_fatal_error("state destination missing after valid-input preflight");
        return db.getInt32(it->second);
    };
    for (auto *BB : states)
        stateSwitch->addCase(stateOf(BB), BB);

    for (auto *T : terminators) {
        llvm::IRBuilder<> b(T);
        b.SetCurrentDebugLocation(T->getDebugLoc());
        llvm::Value *next = nullptr;
        switch (T->getOpcode()) {
        case llvm::Instruction::UncondBr:
            next = stateOf(T->getSuccessor(0));
            break;
        case llvm::Instruction::CondBr: {
            auto *branch = llvm::cast<llvm::CondBrInst>(T);
            next = b.CreateSelect(branch->getCondition(),
                                  stateOf(branch->getSuccessor(0)),
                                  stateOf(branch->getSuccessor(1)), "ms.next");
            break;
        }
        case llvm::Instruction::Switch: {
            auto *sw = llvm::cast<llvm::SwitchInst>(T);
            next = stateOf(sw->getDefaultDest());
            for (auto oneCase : sw->cases()) {
                auto *matches = b.CreateICmpEQ(sw->getCondition(), oneCase.getCaseValue());
                next = b.CreateSelect(matches, stateOf(oneCase.getCaseSuccessor()),
                                      next, "ms.next");
            }
            break;
        }
        case llvm::Instruction::Ret:
        case llvm::Instruction::Unreachable:
            continue;
        default:
            llvm::report_fatal_error("unsupported terminator escaped preflight");
        }
        b.CreateStore(next, slot);
        b.CreateBr(dispatch);
        T->eraseFromParent();
    }
    return true;
}
}
```

