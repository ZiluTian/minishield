unsigned id = 0;
for (auto &BB : F) {
    if (&BB == entry)
        continue;
    stateBlocks.push_back(&BB);
    stateIDs[&BB] = id;
    ++id;
}
for (auto *BB : stateBlocks)
    llvm::errs() << "state " << stateIDs.lookup(BB)
                 << " -> " << BB->getName() << "\n";
```

