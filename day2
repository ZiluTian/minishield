### The full reference file at this checkpoint

This is a complete lib/FlatteningPass.cpp reference to compare after doing the steps. It includes the earlier preparation and mapping, so it replaces the file rather than being appended to your existing run(). It is a study prototype, not a finished production flattener.

```cpp
#include "minishield/FlatteningPass.h"
#include "minishield/FunctionEligibility.h"
#include "llvm/ADT/DenseMap.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/IRBuilder.h"
#include "llvm/IR/Instructions.h"
#include "llvm/Support/Casting.h"
#include "llvm/Support/raw_ostream.h"
#include "llvm/Transforms/Utils/Local.h"
#include <vector>

namespace minishield {
llvm::PreservedAnalyses FlatteningPass::run(
    llvm::Function &F, llvm::FunctionAnalysisManager &) {
    if (F.isDeclaration())
        return llvm::PreservedAnalyses::all();
    const auto eligibility = FunctionEligibility::check(F);
    if (!eligibility.eligible) {
        llvm::errs() << "[MiniShield] rejected: " << F.getName()
                     << ": " << eligibility.reason << "\n";
        return llvm::PreservedAnalyses::all();
    }
    std::vector<llvm::PHINode *> phis;
    for (auto &BB : F) {
        for (auto &I : BB) {
            if (auto *phi = llvm::dyn_cast<llvm::PHINode>(&I)) {
                phis.push_back(phi);
            }
        }
    }
    llvm::errs() << "Number of PHIs: " << phis.size() << "\n";
    for (auto *phi : phis)
        llvm::DemotePHIToStack(phi);

    std::vector<llvm::Instruction *> escapingValues;
    for (auto &BB : F) {
        for (auto &I : BB) {
            if (I.getType()->isVoidTy() || llvm::isa<llvm::AllocaInst>(I))
                continue;
            if (I.isUsedOutsideOfBlock(&BB))
                escapingValues.push_back(&I);
        }
    }
    for (auto *value : escapingValues)
        llvm::DemoteRegToStack(*value);


    std::vector<llvm::BasicBlock *> stateBlocks;
    llvm::DenseMap<llvm::BasicBlock *, unsigned> stateIDs;
    auto *entry = &F.getEntryBlock();
    unsigned id = 0;
    for (auto &BB : F) {
        if (&BB == entry)
            continue;
        stateBlocks.push_back(&BB);
        stateIDs[&BB] = id;
        ++id;
    }
    for (auto *BB : stateBlocks)
        llvm::errs() << "state " << stateIDs.lookup(BB)
                     << " -> " << BB->getName() << "\n";

    bool changed = !phis.empty() || !escapingValues.empty();
    if (!stateBlocks.empty()) {
        llvm::IRBuilder<> setup(&*entry->getFirstInsertionPt());
        auto *stateSlot = setup.CreateAlloca(
            setup.getInt32Ty(), nullptr, "ms.state");
        auto *dispatcher = llvm::BasicBlock::Create(
            F.getContext(), "ms.dispatch", &F);
        auto *invalidBlock = llvm::BasicBlock::Create(
            F.getContext(), "ms.invalid", &F);

        llvm::IRBuilder<> invalidBuilder(invalidBlock);
        invalidBuilder.CreateUnreachable();

        llvm::IRBuilder<> dispatchBuilder(dispatcher);
        auto *current = dispatchBuilder.CreateLoad(
            dispatchBuilder.getInt32Ty(), stateSlot, "ms.current");
        auto *dispatchSwitch = dispatchBuilder.CreateSwitch(
            current, invalidBlock, static_cast<unsigned>(stateBlocks.size()));
        for (auto *BB : stateBlocks) {
            dispatchSwitch->addCase(
                dispatchBuilder.getInt32(stateIDs.lookup(BB)), BB);
        }

        auto *entryTerminator = entry->getTerminator();
        llvm::IRBuilder<> entryBuilder(entryTerminator);
        switch (entryTerminator->getOpcode()) {
        case llvm::Instruction::UncondBr: {
            auto *destination = entryTerminator->getSuccessor(0);
            auto *initialState = entryBuilder.getInt32(stateIDs.lookup(destination));
            entryBuilder.CreateStore(initialState, stateSlot);
            entryBuilder.CreateBr(dispatcher);
            entryTerminator->eraseFromParent();
            break;
        }
        default:
            break; // Conditional entries and other forms are a later exercise.
        }
        changed = true;
    }
    return changed ? llvm::PreservedAnalyses::none()
                   : llvm::PreservedAnalyses::all();
}
} // namespace minishield
```

