isStaticAlloca() encodes LLVM’s entry/constant-size rule, including restrictions such as inalloca. Do not simply move a loop’s alloca into entry: changing how often storage is allocated may change behavior.

### Step 3 — Reject exceptional result and call forms

The full reference rejects non-scalar instruction results, naked functions, inline assembly calls, convergent calls, operand bundles, returns_twice, musttail, and intrinsic calls. Explain the reason for each before relaxing it; rejection is a defined limitation, not a bug to hide.

### The full eligibility reference

```cpp
#include "minishield/FunctionEligibility.h"
#include "llvm/IR/Attributes.h"
#include "llvm/IR/Instructions.h"
#include "llvm/Support/Casting.h"
namespace minishield {
EligibilityResult FunctionEligibility::check(const llvm::Function &F) {
    if (F.isDeclaration()) return {false, "function has no body"};
    if (F.isPresplitCoroutine()) return {false, "presplit coroutine is unsupported"};
    if (F.hasPersonalityFn()) return {false, "exception handling is unsupported"};
    if (F.hasFnAttribute(llvm::Attribute::Naked)) return {false, "naked function is unsupported"};
    for (const auto &BB : F) {
        if (BB.hasAddressTaken()) return {false, "address-taken block is unsupported"};
        if (BB.isEHPad()) return {false, "EH pad is unsupported"};
        switch (BB.getTerminator()->getOpcode()) {
        case llvm::Instruction::UncondBr:
        case llvm::Instruction::CondBr:
        case llvm::Instruction::Switch:
        case llvm::Instruction::Ret:
        case llvm::Instruction::Unreachable: break;
        default: return {false, "unsupported terminator"};
        }
        for (const auto &I : BB) {
            if (const auto *A = llvm::dyn_cast<llvm::AllocaInst>(&I)) {
                if (!A->isStaticAlloca()) return {false, "only static entry allocas are supported"};
            }
            if (const auto *CB = llvm::dyn_cast<llvm::CallBase>(&I)) {
                const auto *callee = CB->getCalledFunction();
                if (callee && callee->isIntrinsic()) return {false, "intrinsic calls are outside this prototype's scope"};
                if (CB->isInlineAsm() || CB->isConvergent() || CB->getNumOperandBundles() ||
                    CB->hasFnAttr(llvm::Attribute::ReturnsTwice))
                    return {false, "special call semantics are unsupported"};
                if (const auto *call = llvm::dyn_cast<llvm::CallInst>(CB))
                    if (call->isMustTailCall()) return {false, "musttail is unsupported"};
            }
            auto *type = I.getType();
            if (!type->isVoidTy() && !type->isIntegerTy() &&
                !type->isFloatingPointTy() && !type->isPointerTy())
                return {false, "only scalar instruction results are supported"};
        }
    }
    return {true, ""};
}
}
```

